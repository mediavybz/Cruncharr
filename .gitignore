*.log
logs/

# Temporary files
*.tmp
*.temp
.cache/

# Test output files
test_output*.txt
test_cookies.txt

# Runtime data - contains credentials and downloaded content
config/
downloads/
# Auth token store written at runtime (NEVER commit - contains live CR tokens)
**/token_*.json
src/Cruncharr.API/Cruncharr/
imgcache/
opencode.json
status.md
*.resume

# Local agent/instruction material (not part of the application)
.agents/
.claude/
examples/

# Local-only documentation (the public repository keeps README only)
*.md
!README.md

# Upstream source reference (fetched on demand)
upstream_src/

# Binary image exports
cruncharr-image.tar

# Local UI screenshot/debug artifacts
shots/

# Local third-party tool binaries (ffmpeg etc.) - not used by the Linux image
tools/

# Desktop/upstream build artifacts (never commit)
CRD.exe
Updater.exe
*.dll
*.exe
