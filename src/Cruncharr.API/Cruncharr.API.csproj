<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <!-- Stable releases use the plain number; the testing channel uses the next number with a
         "-beta" suffix, so the two channels never show the same version. -->
    <Version>1.0.89-beta</Version>
    <AssemblyVersion>$(Version.Split('-')[0]).0</AssemblyVersion>
    <FileVersion>$(Version.Split('-')[0]).0</FileVersion>
    <!-- Web projects default to the server GC: one heap per core (20 on the Unraid host), sized
         for throughput and slow to return memory. Measured 2026-11-18, it committed about three
         times the live data and held over 1 GB while idle, all counted against the RAM
         temp-folder ceiling. The workstation GC suits a single-user background app. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.Newtonsoft" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cruncharr.Core\Cruncharr.Core.csproj" />
  </ItemGroup>

</Project>
